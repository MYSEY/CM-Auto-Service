{
    "appId": "com.cmautoservice.app",
    "appName": "CM Auto Service",
    "webDir": "public",
    "server": {
        "url": "https://www.cmautoservic.com/pwa",
        "cleartext": false,
        "androidScheme": "https"
    },
    "android": {
        "allowMixedContent": true
    },
    "plugins": {
        "StatusBar": {
            "overlaysWebView": true,
            "style": "DARK"
        },
        "SplashScreen": {
            "launchShowDuration": 2000,
            "launchAutoHide": true,
            "backgroundColor": "#0d1b3e"
        }
    }
}